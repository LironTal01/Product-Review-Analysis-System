# Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL (optional)
# When unset or unreachable, the API still works but does not persist
# results. Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql://pras:pras@localhost:5432/pras

# Redis (optional)
# When unset or unreachable, the API still works but will not cache
# results. Format: redis://[:PASSWORD@]HOST:PORT/DBINDEX
# REDIS_URL=redis://localhost:6379/0
