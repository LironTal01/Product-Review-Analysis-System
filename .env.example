# Required for the complete live-analysis pipeline
OPENAI_API_KEY=
SCRAPER_API_KEY=

# Model and application settings
OPENAI_LLM_MODEL=gpt-5-nano
APP_NAME=PRAS
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Disabled by default so mock data is never presented as live data accidentally
ALLOW_MOCK_FALLBACK=false

# Optional for direct local runs; Docker Compose supplies its own Redis URL
REDIS_URL=
REDIS_PASSWORD=pras-local
